# shellcheck shell=bash
# -------------------------
# Navegación y Sistema (Seguros)
# -------------------------
alias ls='ls --color=auto'
alias la='ls -A'
alias ll='ls -alF'
alias l='ls -CF'
alias grep='grep --color=auto'

alias cp='cp -i'
alias mv='mv -i'
# rm ya es recursivo: -I pide confirmación antes de borrados grandes y
# --preserve-root evita `rm -rf /` accidentales.
alias rm='rm -I --preserve-root'
alias rmf='rm -rf --preserve-root'

# -------------------------
# Arch Linux (pacman)
# -------------------------
alias pi='sudo pacman -S --needed'

# -------------------------
# Git Shortcuts
# -------------------------
alias gs='git status'
alias gp='git pull'
alias gpp='git push'
alias gc='git commit -am'

# -------------------------
# Editor
# -------------------------
alias n='nvim'
alias oc='opencode'

# -------------------------
# Desarrollo (React Native / Expo / Mobile)
# -------------------------
alias android='yarn android && code .'
alias run-react='yarn react-native run-android && yarn react-native start'
alias exp='bunx create-expo-app@latest --template blank-typescript'
alias em='androidemulator'

# -------------------------
# Proyectos C/C++
# -------------------------
alias mkc='~/.dotfiles/scripts/mkc.sh'

# -------------------------
# IA local (llama.cpp sobre Intel Arc B570)
# -------------------------
alias ai-check='~/.dotfiles/scripts/llama-check.sh'
alias ai-models='~/.dotfiles/scripts/llama-model.sh list'
alias ai-model='~/.dotfiles/scripts/llama-model.sh'
alias ai-bench='~/.dotfiles/scripts/llama-check.sh --bench'
alias ai-svc='systemctl --user status llama-server --no-pager'
