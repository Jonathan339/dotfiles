[Unit]
Description=llama.cpp server - modelo activo de ~/models (Intel Arc B570, Vulkan)
Documentation=https://github.com/ggml-org/llama.cpp
# El backend Vulkan necesita el driver xe y el compositor ya inicializados.
After=graphical-session.target

[Service]
Type=simple
# Los flags viven en ~/models/<modelo>/serve.sh. llama-serve.sh resuelve el
# symlink ~/.config/llama-current (lo maneja scripts/llama-model.sh) y cae al
# 9B si el selector todavía no existe. Para cambiar de modelo: llama-model.sh.
ExecStart=%h/.dotfiles/scripts/llama-serve.sh

Restart=on-failure
RestartSec=3

[Install]
WantedBy=default.target
