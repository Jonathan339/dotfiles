[Unit]
Description=llama.cpp server - Qwen3.5 9B (Intel Arc B570, Vulkan)
Documentation=https://github.com/ggml-org/llama.cpp
# El backend Vulkan necesita el driver xe y el compositor ya inicializados.
After=graphical-session.target

[Service]
Type=simple
# Binario compilado local (0.7.0-dev): /usr/bin/llama-server es 0.6.0 y no tiene MTP.
ExecStart=%h/.local/bin/llama serve \
  --model %h/models/Qwen3.5-9B-Uncensored-HauhauCS-Aggressive-Q4_K_M.gguf \
  --alias qwen3.5-9b \
  --ctx-size 24576 \
  --n-gpu-layers 99 \
  --flash-attn on \
  --cache-type-k q8_0 \
  --cache-type-v q8_0 \
  --parallel 1 \
  --device Vulkan0 \
  --host 127.0.0.1 \
  --port 8080

Restart=on-failure
RestartSec=3

# Para decodificación especulativa MTP (el GGUF la soporta) agregar:
#   --spec-type draft-mtp --spec-draft-n-max 2

[Install]
WantedBy=default.target
