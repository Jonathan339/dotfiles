{
  "$schema": "https://opencode.ai/config.json",
  "provider": {
    "ollama": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Ollama (local)",
      "options": {
        "baseURL": "http://localhost:11434/v1"
      },
      "models": {
        "phi3.5:latest": {
          "name": "Phi 3.5 (fast)",
          "limit": {
            "context": 4096,
            "output": 2048
          }
        }
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "/home/jonathan/.local/bin/codebase-memory-mcp"
      ]
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permission": "allow"
}
