{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "model": "llamacpp/qwen3.5-9b",
  "providers": {
    "llamacpp": {
      "name": "llama.cpp (local, Intel Arc B570)",
      "package": "@opencode/ai/providers/openai-compatible",
      "settings": {
        "baseURL": "http://127.0.0.1:8082/v1"
      },
      "models": {
        "qwen2.5-coder-7b": {
          "name": "Qwen2.5 Coder 7B Instruct Q5_K_M (llama.cpp)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5-4b": {
          "name": "Qwen3.5 4B Q8_0 (llama.cpp, visión)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 32768, "output": 8192 }
        },
        "qwen3.5-9b": {
          "name": "Qwen3.5 9B Uncensored Q4_K_S (llama.cpp, visión)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 24576, "output": 8192 }
        },
        "deepseek-v4-pro-9b": {
          "name": "DeepSeek V4 Pro Qwen3.5 9B Uncensored Q4_K_M (llama.cpp)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": { "context": 24576, "output": 8192 }
        },
        "gemma-4-e4b": {
          "name": "Gemma 4 E4B Uncensored Aggressive Q3_K_M (llama.cpp, visión)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": { "context": 32768, "output": 8192 }
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["/home/jonathan/.local/bin/codebase-memory-mcp"],
        "cwd": "/home/jonathan/.dotfiles"
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": ["bun", "x", "@playwright/mcp@latest"],
        "enabled": true
      }
    }
  },
  "permission": {
    "*": "allow"
  }
}
