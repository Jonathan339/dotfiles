{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "name": "Ollama (local, Intel Arc B570)",
      "settings": {
        "baseURL": "http://127.0.0.1:11434/v1"
      },
      "models": {
        "gemma3:12b": {
          "name": "Gemma 3 12B (local, texto+imagen)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          }
        },
        "qwen3:8b": {
          "name": "Qwen3 8B (local, rápido)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 8192,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "/home/jonathan/.local/bin/codebase-memory-mcp"
      ]
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permission": "allow"
}
