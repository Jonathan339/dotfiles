{
  "$schema": "https://opencode.ai/config.json",
  "shell": "/bin/zsh",
  "providers": {
    "ollama": {
      "name": "Ollama (local, Intel Arc B570)",
      "models": {
        "qwen3.5-uncensored:4b": {
          "name": "Qwen3.5 Uncensored 4B",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {"context": 32768, "output": 4096}
        },
        "qwen2.5-coder:7b": {
          "name": "Qwen2.5 Coder 7B (no configurado)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {"context": 32768, "output": 4096}
        }
      }
    }
  },
  "mcp": {
    "servers": {
      "codebase-memory-mcp": {
        "type": "local",
        "command": ["/home/jonathan/.local/bin/codebase-memory-mcp"]
      },
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      },
      "playwright": {
        "type": "local",
        "command": ["/home/jonathan/.bun/bin/bunx", "@executeautomation/playwright-mcp-server"]
      },
      "browserbase": {
        "type": "local",
        "disabled": true,
        "command": ["node", "/home/jonathan/mcp-server-browserbase/cli.js"],
        "cwd": "/home/jonathan/mcp-server-browserbase",
        "environment": {
          "BROWSERBASE_API_KEY": "{env:BROWSERBASE_API_KEY}",
          "BROWSERBASE_PROJECT_ID": "{env:BROWSERBASE_PROJECT_ID}",
          "GEMINI_API_KEY": "{env:GEMINI_API_KEY}"
        }
      }
    }
  },
  "permission": {
    "*": "allow"
  }
}
