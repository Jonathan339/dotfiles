{
  "$schema": "https://opencode.ai/config.json",
  "providers": {
    "ollama": {
      "name": "Ollama (local, Intel Arc B570)",
      "models": {
        "qwen3.5:0.8b": {
          "name": "Qwen3.5 0.8B (local, rápido)",
          "capabilities": {
            "tools": true,
            "input": ["text", "image"],
            "output": ["text"]
          },
          "limit": {
            "context": 32768,
            "output": 4096
          }
        },
        "s1gnature/gemma4-uncensored-mtp:e2b-q4_k_m": {
          "name": "Gemma 4 E2B Uncensored Q4 (local, sin filtros)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32000,
            "output": 4096
          }
        },
        "s1gnature/gemma4-uncensored-mtp:e2b-q8_0": {
          "name": "Gemma 4 E2B Uncensored Q8 (local, sin filtros)",
          "capabilities": {
            "tools": true,
            "input": ["text"],
            "output": ["text"]
          },
          "limit": {
            "context": 32000,
            "output": 4096
          }
        }
      }
    }
  },
  "mcp": {
    "codebase-memory-mcp": {
      "enabled": true,
      "type": "local",
      "command": [
        "/home/jonathan/.local/bin/codebase-memory-mcp"
      ]
    },
    "servers": {
      "context7": {
        "type": "remote",
        "url": "https://mcp.context7.com/mcp"
      }
    }
  },
  "permission": "allow"
