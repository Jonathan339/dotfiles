{
  "$schema": "https://opencode.ai/config.json",
    "provider": {
        "llamacpp": {
            "npm": "@ai-sdk/openai-compatible",
            "name": "llama.cpp (local)",
            "options": {
                "baseURL": "http://127.0.0.1:8080/v1"
            },
            "models": {
                "DeepSeek-R1-Distill-Qwen-1.5B-Q4_K_M": {
                    "name": "DeepSeek R1 1.5B (local)",
                    "limit": {
                        "context": 16384,
                        "output": 4096
                    }
                },
                "DeepSeek-R1-Distill-Qwen-7B-Q4_K_M": {
                    "name": "DeepSeek R1 7B (local)",
                    "limit": {
                        "context": 8192,
                        "output": 4096
                    }
                },
                "Qwen3-4B-Thinking-2507-Q4_K_M": {
                    "name": "Qwen3 4B Thinking (local)",
                    "limit": {
                        "context": 16384,
                        "output": 4096
                    }
                }
            }
        },
        "ollama": {
            "npm": "@ai-sdk/ollama",
            "name": "Ollama",
            "options": {
                "baseURL": "http://localhost:11434/api"
            }
        }
    },
    "mcp": {
        "codebase-memory-mcp": {
            "enabled": true,
            "type": "local",
            "command": [
                "/home/jonathan/.local/bin/codebase-memory-mcp"
            ]
        }
    },
    "permission": "allow"
}
