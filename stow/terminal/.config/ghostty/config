# ==============================================================================
# Ghostty Config — Solo Leveling Theme (Shadow Monarch Edition)
# ==============================================================================

# ====== Fuente ======
font-family = DroidSansM Nerd Font
font-size = 12

# ====== Ventana ======
background-opacity = 0.9
window-padding-x = 2
window-padding-y = 2

# ====== Colores ======
config-file = colors/ghostty-colors

# ====== Cursor ======
cursor-style = bar
cursor-style-blink = false

# ====== Shell ======
command = zsh

# ====== Mouse ======
mouse-hide-while-typing = true

# ====== Keybindings ======
# --- Ventanas (Splits) ---
keybind = ctrl+shift+n=new_split:right
keybind = ctrl+shift+q=close_surface
keybind = ctrl+shift+left=goto_split:previous
keybind = ctrl+shift+right=goto_split:next
keybind = ctrl+shift+f5=reload_config

# --- Pestañas ---
keybind = ctrl+t=new_tab
keybind = ctrl+q=close_tab
keybind = ctrl+right=next_tab
keybind = ctrl+tab=next_tab
keybind = ctrl+left=previous_tab
keybind = ctrl+shift+tab=previous_tab
keybind = ctrl+shift+up=move_tab:1
keybind = ctrl+shift+down=move_tab:-1

# --- Extras ---
keybind = ctrl+shift+enter=new_window
keybind = ctrl+shift+s=new_tab
keybind = ctrl+shift+l=clear_screen
