#!/bin/bash
# Menú de energía: apagar, reiniciar, suspender, bloquear, cerrar sesión
options="Apagar\nReiniciar\nSuspender\nBloquear\nCerrar sesión"

chosen=$(printf "%b" "$options" | rofi -dmenu -p "Energía" -i)

case "$chosen" in
    "Apagar") systemctl poweroff ;;
    "Reiniciar") systemctl reboot ;;
    "Suspender") systemctl suspend ;;
    "Bloquear") hyprlock ;;
    "Cerrar sesión") hyprctl dispatch exit ;;
esac
