[Unit]
Description=OpenClaw Gateway
After=network-online.target
Wants=network-online.target
StartLimitBurst=10
StartLimitIntervalSec=300

[Service]
ExecStart=/home/jonathan/.local/share/fnm/node-versions/v26.13.0/installation/bin/node --max-old-space-size=7674 /home/jonathan/.local/share/fnm/node-versions/v26.13.0/installation/lib/node_modules/openclaw/dist/index.js gateway --port 18789
Restart=always
RestartSec=5
RestartPreventExitStatus=78
TimeoutStopSec=330
TimeoutStartSec=30
SuccessExitStatus=0 143
OOMPolicy=continue
KillMode=mixed
Environment=HOME=/home/jonathan
Environment=TMPDIR=/tmp
Environment=NODE_EXTRA_CA_CERTS=/etc/ssl/certs/ca-certificates.crt
Environment=PATH=/home/jonathan/.local/share/fnm/node-versions/v26.13.0/installation/bin:/run/user/1000/fnm_multishells/2659_1793530227803/bin:/usr/local/bin:/usr/bin:/bin:/home/jonathan/.local/share/pnpm:/home/jonathan/.local/share/pnpm/bin:/home/jonathan/.bun/bin:/home/jonathan/.local/share/fnm/aliases/default/bin:/home/jonathan/.local/share/fnm/current/bin:/home/jonathan/.local/bin:/home/jonathan/.npm-global/bin:/home/jonathan/bin:/home/jonathan/.nix-profile/bin
Environment=NODE_OPTIONS=
Environment=OPENCLAW_GATEWAY_PORT=18789
Environment=OPENCLAW_SYSTEMD_UNIT=openclaw-gateway.service
Environment="OPENCLAW_WINDOWS_TASK_NAME=OpenClaw Gateway"
Environment=OPENCLAW_WINDOWS_TASK_HIDDEN_LAUNCHER=1
Environment=OPENCLAW_SERVICE_MARKER=openclaw
Environment=OPENCLAW_SERVICE_KIND=gateway

[Install]
WantedBy=default.target
