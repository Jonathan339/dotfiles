[global]
    monitor = 0
    follow = mouse
    width = 350
    height = 200
    origin = top-right
    offset = 12x12
    scale = 0
    notification_limit = 5
    progress_bar = true
    progress_bar_height = 4
    progress_bar_frame_width = 0
    progress_bar_min_width = 150
    progress_bar_max_width = 300
    progress_bar_corner_radius = 2
    icon_theme = Adwaita
    dmenu = /usr/bin/rofi -dmenu -p dunst
    browser = /usr/bin/google-chrome
    corner_radius = 12
    ignore_icon_position = false
    ignore_newline = false
    stack_duplicates = true
    hide_duplicate_count = true
    show_indicators = false
    word_wrap = true
    ellipsize = middle
    line_height = 0
    separator_height = 4
    padding = 12
    horizontal_padding = 12
    text_icon_padding = 8
    frame_width = 1
    frame_color = #33ccff
    gap_size = 4
    font = "Noto Sans 10"
    format = "<b>%s</b>\n%b"
    alignment = left
    vertical_alignment = center
    icon_position = left
    min_icon_size = 48
    max_icon_size = 64
    icon_path = /usr/share/icons/Adwaita/16x16/status/:/usr/share/icons/Adwaita/32x32/status/:/usr/share/icons/hicolor/48x48/apps/
    transparency = 5

[urgency_low]
    background = "#161616"
    foreground = "#e6e6e6"
    timeout = 6

[urgency_normal]
    background = "#1c1c1c"
    foreground = "#ffffff"
    timeout = 8

[urgency_critical]
    background = "#3d1d1d"
    foreground = "#ff6b6b"
    timeout = 0

[shortcuts]
    close = ctrl+space
    close_all = ctrl+shift+space
    history = ctrl+grave
    context = ctrl+shift+period
